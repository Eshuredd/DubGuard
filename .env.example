# No network calls are implemented by the AMD scaffold, even if configured.
DUBGUARD_SEMANTIC_PROVIDER=disabled
AMD_TOKEN_FACTORY_ENDPOINT=
AMD_TOKEN_FACTORY_MODEL=
AMD_TOKEN_FACTORY_API_KEY=
# Endpoint, request/response contract, auth, and model must be confirmed with AMD.
# The CLI does not auto-load .env; export variables in your shell if needed.
