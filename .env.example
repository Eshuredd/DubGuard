# Real AMD calls require hybrid verification, consented Quick Test AMD mode,
# or explicitly opted-in remote evaluation. Local Quick Test never calls AMD.
DUBGUARD_SEMANTIC_PROVIDER=disabled
# Verified Token Factory base URL; a full /chat/completions URL also works.
AMD_TOKEN_FACTORY_ENDPOINT=https://developer.amd.com.cn/radeon/api/v1
AMD_TOKEN_FACTORY_MODEL=DeepSeek-V4-Flash
# Optional and independent of the semantic model. No MiMo call is automatic.
AMD_TOKEN_FACTORY_AUDIO_MODEL=MiMo-V2.6-Flash
AMD_TOKEN_FACTORY_API_KEY=
# Optional bounded transport settings.
AMD_TOKEN_FACTORY_TIMEOUT_SECONDS=40
AMD_TOKEN_FACTORY_CONNECT_TIMEOUT_SECONDS=5
AMD_TOKEN_FACTORY_MAX_OUTPUT_TOKENS=1024
AMD_TOKEN_FACTORY_AUDIO_TIMEOUT_SECONDS=45
AMD_TOKEN_FACTORY_AUDIO_MAX_RETRIES=0
AMD_TOKEN_FACTORY_MAX_RETRIES=2
# Audio and reviewer workflow. Set a private writable directory and provide
# DUBGUARD_REVIEW_TOKENS_JSON only through the environment, never in Git.
DUBGUARD_DATA_DIR=.dubguard-data
DUBGUARD_WHISPER_MODEL=tiny.en
DUBGUARD_MAX_UPLOAD_BYTES=25000000
DUBGUARD_MAX_AUDIO_SECONDS=1200
DUBGUARD_ASR_CHUNK_SECONDS=30
DUBGUARD_ASR_OVERLAP_SECONDS=2
DUBGUARD_ASR_CPU_THREADS=2
# The CLI reads .env from the current working directory, without overriding
# already-exported variables. Never commit a populated .env file.

# Sample and custom local reviews are always public, scoped and temporary.
# Private operator APIs still require independent reviewer authentication.
DUBGUARD_CLIENT_EDITS_PER_HOUR=60
DUBGUARD_OPERATOR_LOGINS_PER_HOUR=8
# Separate random 24+ character code; never reuse a reviewer/provider key.
# This is checked for every AMD demo analysis in addition to fresh consent.
DUBGUARD_AMD_DEMO_ACCESS_CODE=
# Expiring, persistent per-client attempt accounting. Hard upper bounds: 30/90.
DUBGUARD_CLIENT_SESSIONS_PER_HOUR=4
DUBGUARD_CLIENT_UPLOADS_PER_HOUR=6
# Empty by default. For the provided Compose network, explicitly trust only
# Caddy's configured static address after verifying it: 172.30.71.2/32.
DUBGUARD_TRUSTED_PROXIES=
# All server ASR paths now require a locally cached model; no automatic downloads.
# See DEPLOYMENT.md for pinned model setup and server-only secret configuration.
# Quick Test AMD mode has its own per-request selection, two-run session quota,
# one concurrent demo HTTP call and one HTTP attempt/run, independent of the
# legacy DUBGUARD_SEMANTIC_PROVIDER selector above. Missing config fails visibly.
