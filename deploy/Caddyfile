{
    servers {
        timeouts {
            read_body 30s
        }
    }
}
{$DUBGUARD_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "microphone=(self)"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    request_body {
        max_size 26MB
    }
    @quick_upload path /api/quick/analyze /api/workspace/analyze
    request_body @quick_upload {
        max_size 10065536
    }
    @quick_session path /api/quick/sessions /api/workspace/sessions /api/operator/session
    request_body @quick_session {
        max_size 4096
    }
    @workspace_edit path /api/workspace/reference /api/workspace/evidence /api/workspace/review
    request_body @workspace_edit {
        max_size 32768
    }
    handle_path /api/* {
        reverse_proxy api:8000 {
            header_up X-Forwarded-For {http.request.remote.host}
            header_up -Forwarded
            transport http {
                response_header_timeout 180s
            }
        }
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
